<?xml version="1.0" encoding="utf-8"?>
<!-- Public runners restore from nuget.org only. Do not add local package folders. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
